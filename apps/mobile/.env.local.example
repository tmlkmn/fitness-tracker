# Copy to .env.local (gitignored). Restart `npx expo start` after changing it.

# Backend the app talks to. Default: production (https://www.fitmusc.com).
# To use the web app running on this computer instead, put its LAN address
# here — the phone can't reach "localhost":
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
