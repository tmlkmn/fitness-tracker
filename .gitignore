# Repo-wide ignores. App-specific rules live in each app's own .gitignore
# (e.g. apps/web/.gitignore), anchored to that app's directory.

# dependencies (root + every workspace)
node_modules/

# env files — never commit secrets from any workspace
.env*
!.env.local.example

# misc
.DS_Store
*.pem
*.tsbuildinfo
npm-debug.log*

# tooling caches
.turbo/
.vercel

# Claude Code (personal/local settings — shared settings go in .claude/settings.json)
.claude/settings.local.json
