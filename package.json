{
  "name": "fitmusc-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fitmusc/web",
    "build": "npm run build -w @fitmusc/web",
    "start": "npm run start -w @fitmusc/web",
    "lint": "npm run lint -w @fitmusc/web",
    "db:generate": "npm run db:generate -w @fitmusc/web",
    "db:migrate": "npm run db:migrate -w @fitmusc/web",
    "db:push": "npm run db:push -w @fitmusc/web",
    "db:seed": "npm run db:seed -w @fitmusc/web",
    "db:studio": "npm run db:studio -w @fitmusc/web",
    "eval:plans": "npm run eval:plans -w @fitmusc/web --",
    "check:macro-engine": "npm run check:macro-engine -w @fitmusc/web",
    "typecheck:shared": "npm run typecheck -w @fitmusc/shared"
  }
}
