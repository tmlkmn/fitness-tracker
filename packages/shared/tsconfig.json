{
  "compilerOptions": {
    "target": "ES2020",
    // No "dom": this code also runs in React Native (Hermes) and on the server.
    "lib": ["ES2022"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
